# PostgreSQL (docker-compose service "postgres"; host port 5433 to avoid clashing with other local Postgres containers)
DATABASE_URL="postgresql://dealflow360:dealflow360@localhost:5433/dealflow360?schema=public"

# Redis (docker-compose service "redis"; host port 6380) - BullMQ queue coordination only, never business state
REDIS_URL="redis://localhost:6380"

NODE_ENV="development"
