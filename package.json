  "private": true,
  "engines": {
    "node": "22.16.0"
  },
  "scripts": {
    "dev": "node --experimental-loader=./loader/ts-alias-loader.mjs --experimental-strip-types --env-file=.env server.ts --dev",
    "build": "next build --turbopack",
    "start": "node --experimental-loader=./loader/ts-alias-loader.mjs --experimental-strip-types --env-file=.env server.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx --env-file=.env prisma/seed.ts",
    "worker": "tsx --env-file=.env src/jobs/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
