    "@prisma/client": "7.10.0",
    "@rolldown/binding-wasm32-wasi": "^1.2.7",
    "@rolldown/binding-win32-x64-msvc": "^1.2.7",
    "bullmq": "6.3.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "ioredis": "5.6.1",
    "lucide-react": "1.41.0",
    "next": "15.5.25",
    "pg": "8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.87.0",
    "socket.io": "4.8.3",
